# ==========================================
# NESS CHATBOT - LOCAL DEVELOPMENT SETUP
# ==========================================
# Use this file for local development with docker-compose
# Copy to .env when developing locally: cp .env.local.example .env

# ========================================
# AWS CREDENTIALS (Local - Dummy values for MinIO)
# ========================================
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1

# ========================================
# LLM PROVIDER CONFIGURATION
# ========================================
LLM_PROVIDER=bedrock
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0
BEDROCK_EMBEDDINGS_MODEL_ID=amazon.titan-embed-text-v1

# ========================================
# LOCAL AWS ENDPOINTS (docker-compose)
# ========================================
AWS_ENDPOINT_URL=http://localhost:9000
DYNAMODB_ENDPOINT_URL=http://localhost:8000

# ========================================
# DATABASE & STORAGE (Local)
# ========================================
DYNAMODB_TABLE_CANDIDATES=page_candidates
DYNAMODB_TABLE_CACHE=response_cache
S3_BUCKET_INDEX=ness-chatbot-index

# ========================================
# MINIO CONFIGURATION (Local S3)
# ========================================
MINIO_ENDPOINT_URL=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ========================================
# ADMIN API SECURITY
# ========================================
# Safe default for local development
ADMIN_API_KEY=dev-secret-key-change-in-prod

# ========================================
# SERVER CONFIGURATION
# ========================================
SERVER_PORT=8080
SERVER_HOST=0.0.0.0

# ========================================
# LANGSMITH OBSERVABILITY (Optional)
# ========================================
# Leave blank to disable, or add your key for local testing
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ness-chatbot-local
